aws_region  = "eu-west-2"
environment = "dev"

vpc_cidr = "10.42.0.0/16"

container_port    = 8000
health_check_path = "/health"

log_retention_days = 14

ecr_force_delete        = false
alb_deletion_protection = false

container_image_tag = "bootstrap"

task_cpu    = 512
task_memory = 1024

# Keep this at zero during the infrastructure bootstrap.
# GitHub Actions activates the service after the first ECR image is pushed.
service_desired_count = 0

deployment_health_check_grace_period_seconds = 90

github_repository = "tosinmulero/railflow-ml-data-platform"

extra_tags = {
  Portfolio = "true"
  Owner     = "tosinmulero"
}
# Immutable GitHub OIDC identity for repositories created after 15 July 2026.
github_oidc_subject = "repo:tosinmulero@53153299/railflow-ml-data-platform@1407973668:ref:refs/heads/main"
